{
  "expo": {
    "name": "IBI Lounge",
    "slug": "lounge-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.utme.lounge-app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.space.utme.lounge"
        ]
      },
      "appleTeamId": "89P49T5697",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#087A83"
      },
      "package": "space.utme.loungeapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#087A83"
        }
      ],
      "expo-localization",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "space.utme.lounge-app.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.space.utme.lounge"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "bd7837a2-01b1-4778-958d-acbdb5b91a48"
      }
    }
  }
}
